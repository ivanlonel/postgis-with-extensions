{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    // Before 8am every Monday, ahead of the weekly image rebuild.
    "* 0-7 * * 1"
  ],
  "minimumReleaseAge": "1 day",
  "prHourlyLimit": 5,
  // Merge automatically once CI passes; major updates wait for a review (see packageRules).
  "automerge": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "conflicted",
  // Raise PRs for known vulnerabilities from the osv.dev database, independent of the schedule.
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  // enabledManagers is a strict allowlist: custom.regex must be named for the managers below to run.
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pre-commit",
    "custom.regex"
  ],
  // pre-commit support is in beta and requires an explicit opt-in.
  "pre-commit": {
    "enabled": true
  },
  "customDatasources": {
    // PGXN lists each distribution's releases at api.pgxn.org/dist/<name>.json.
    "pgxn": {
      "defaultRegistryUrlTemplate": "https://api.pgxn.org/dist/{{packageName}}.json",
      "transformTemplates": [
        "{\"releases\": [releases.stable.{\"version\": version, \"releaseTimestamp\": date}]}"
      ]
    }
  },
  "customManagers": [
    {
      // Versions of the sources the Dockerfile builds or downloads: an ARG line preceded by a
      // "# renovate: datasource=... depName=... [extractVersion=...] [versioning=...]" comment.
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s+ARG [A-Z0-9_]+=(?<currentValue>\\S+)"
      ]
    },
    {
      // Bake variables preceded by a "# renovate:" comment (TimescaleDB for the current majors).
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+variable \"[A-Z0-9_]+\" \\{\\s+default = \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      // "<distribution> <version>" lines of the PGXN package list.
      "customType": "regex",
      "managerFilePatterns": [
        "/^build/pgxn-packages\\.txt$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>[a-z0-9_]+) (?<currentValue>\\S+)$"
      ],
      "datasourceTemplate": "custom.pgxn"
    },
    {
      // "<owner/repo> <tag> ..." lines of the GitHub package list. A tag has a non-hex character,
      // which tells it from a commit (Renovate's regex engine has no lookahead).
      "customType": "regex",
      "managerFilePatterns": [
        "/^build/github-packages\\.txt$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>[\\w.-]+/[\\w.-]+) (?<currentValue>[^\\s]*[^0-9a-f\\s][^\\s]*)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      // "<owner/repo> <commit> branch=<branch> ..." lines: follow the branch's head.
      "customType": "regex",
      "managerFilePatterns": [
        "/^build/github-packages\\.txt$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>[\\w.-]+/[\\w.-]+) (?<currentDigest>[0-9a-f]{40}) branch=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      // Don't suggest upgrades for the project's required Python version.
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      // The extension sources baked into the image, tested together by the image CI.
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "image sources"
    },
    {
      "matchManagers": [
        "pep621",
        "pre-commit"
      ],
      "groupName": "python tooling"
    },
    {
      // prek-action's prek-version input moves with the dev group's prek.
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "prek"
      ],
      "groupName": "python tooling"
    },
    {
      // CYBERTEC tags its releases RELEASE_<major>_<minor>_<patch>.
      "matchDepNames": [
        "cybertec-postgresql/db_migrator",
        "cybertec-postgresql/ora_migrator"
      ],
      "versioning": "regex:^RELEASE_(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)$"
    },
    {
      // The Citus lines built for older PostgreSQL majors stay on their own major (see Dockerfile).
      "matchDepNames": [
        "citusdata/citus"
      ],
      "matchCurrentValue": "/^13\\./",
      "allowedVersions": "/^13\\./"
    },
    {
      "matchDepNames": [
        "citusdata/citus"
      ],
      "matchCurrentValue": "/^12\\./",
      "allowedVersions": "/^12\\./"
    },
    {
      // A new major (e.g. of TimescaleDB) can require users to update their databases: review it.
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
