# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{conf,geojson,hcl,json,md,toml,yaml,yml}]
indent_size = 2

# Tabs: `<<-` heredocs (z_conf.sh) only strip leading tabs, and shfmt reads this file.
[*.sh]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
